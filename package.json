{
  "name": "@buzzysin-org/buzzybot-framework",
  "author": "buzzysin <buzzysin@users.noreply@github.com>",
  "license": "ISC",
  "version": "0.0.0-alpha.0",
  "private": true,
  "files": [
    "dist",
    "buzzybot.json"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:watch": "turbo run build -- --watch",
    "clean": "pnpm -w -r run clean && rimraf *.log",
    "dev": "turbo run dev --parallel",
    "start": "node dist/index.js",
    "test": "turbo run test",
    "build:types": "tsc -b",
    "typecheck": "tsc --noEmit",
    "workspace:run": "pnpm -w -r run",
    "workspace:exec": "pnpm -w -r exec",
    "prebuild": "npm run clean",
    "build:check": "npm run build && echo 'Build successful' && npm run clean",
    "refresh": "rimraf node_modules && pnpm -w install"
  },
  "description": "Monorepo for a Discord.JS bot-building 'framework'",
  "main": "index.js",
  "devDependencies": {
    "@types/node": "24.3.0",
    "depcheck": "^1.4.7",
    "jest": "30.1.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.1",
    "tsup": "^6.4.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "discord",
    "discord.js",
    "framework",
    "dependency-injection",
    "injex"
  ],
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@buzzybot/cli": "workspace:*"
  }
}
